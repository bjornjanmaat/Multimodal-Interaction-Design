const uint8_t* const danceFrames[4] = { frame0, frame1, frame2, frame3 };
const uint16_t dancerColors[4] = { COLOR_CYAN, COLOR_MAGENTA, COLOR_GREEN, COLOR_YELLOW };

void drawSilhouette(uint8_t x, uint8_t y, const uint8_t *bitmap, uint16_t fgColor, uint16_t bgColor) {
  setAddrWindow(x, y, x + DANCER_W - 1, y + DANCER_H - 1);
  digitalWrite(TFT_DC, HIGH);
  digitalWrite(TFT_CS, LOW);

  uint8_t fgHi = fgColor >> 8, fgLo = fgColor & 0xFF;
  uint8_t bgHi = bgColor >> 8, bgLo = bgColor & 0xFF;

  for (uint8_t row = 0; row < DANCER_H; row++) {
    for (uint8_t byteIdx = 0; byteIdx < (DANCER_W / 8); byteIdx++) {
      uint8_t b = pgm_read_byte(&bitmap[row * (DANCER_W / 8) + byteIdx]);
      for (int8_t bit = 7; bit >= 0; bit--) {
        if (b & (1 << bit)) {
          SPI.transfer(fgHi);
          SPI.transfer(fgLo);
        } else {
          SPI.transfer(bgHi);
          SPI.transfer(bgLo);
        }
      }
    }
  }
  digitalWrite(TFT_CS, HIGH);
}

void initST7735() {
  pinMode(TFT_CS, OUTPUT);
  pinMode(TFT_DC, OUTPUT);
  pinMode(TFT_RST, OUTPUT);

  SPI.begin();
  SPI.setClockDivider(SPI_CLOCK_DIV4);

  digitalWrite(TFT_RST, HIGH);
  delay(10);
  digitalWrite(TFT_RST, LOW);
  delay(10);
  digitalWrite(TFT_RST, HIGH);
  delay(120);

  sendCommand(0x11);
  delay(120);
  sendCommand(0x3A);
  sendData(0x05);
  sendCommand(0x29);
  delay(20);
}

void updateStageLights(uint8_t step) {
  const uint16_t laserColors[4] = { COLOR_RED, COLOR_CYAN, COLOR_YELLOW, COLOR_MAGENTA };
  for (uint8_t i = 0; i < 4; i++) {
    uint16_t c = laserColors[(i + step) % 4];
    fillRect(10 + i * 28, 2, 22, 4, c);
  }

  for (uint8_t j = 0; j < 6; j++) {
    uint16_t dotCol = ((j + step) % 2 == 0) ? COLOR_CYAN : COLOR_MAGENTA;
    fillRect(8 + j * 20, 94, 12, 3, dotCol);
  }

  uint16_t spotGlow = ((step % 2) == 0) ? 0x2174 : 0x410C;
  fillRect(36, 99, 56, 8, spotGlow);
}

void setup() {
  initST7735();

  fillRect(0, 0, 128, 94, COLOR_BG);
  fillRect(0, 94, 128, 3, COLOR_MAGENTA);
  fillRect(0, 97, 128, 31, COLOR_FLOOR);
}

uint8_t currentFrame = 0;
const uint8_t dancerX = 48;
const uint8_t dancerY = 36;

void loop() {
  updateStageLights(currentFrame);
  drawSilhouette(dancerX, dancerY, danceFrames[currentFrame], dancerColors[currentFrame], COLOR_BG);

  delay(170);
  currentFrame = (currentFrame + 1) % 4;
}
